# Telegram
BOT_TOKEN=
# Daftar Telegram user ID admin awal, dipisah koma. Contoh: 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Database MySQL (DB_PASSWORD boleh kosong untuk MySQL lokal tanpa password, mis. XAMPP root)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=5

# Operasional
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
NODE_ENV=development

# Kebijakan lembur (bisa diubah, dokumentasikan asumsi)
OVERTIME_MIN_MINUTES=30
OVERTIME_ROUNDING_MINUTES=15
OVERTIME_MAX_HOURS_PER_DAY=8

# ===== Web Admin (Tahap 1) =====
# Secret sesi cookie — WAJIB, minimal 32 karakter acak. Generate: openssl rand -hex 32
SESSION_SECRET=
# Umur sesi login (jam)
WEB_SESSION_TTL_HOURS=8
# Set 1 saat berjalan di belakang reverse proxy (cPanel/Passenger) agar req.ip benar
TRUST_PROXY=0
# Konfirmasi eksplisit untuk script penulisan web (bootstrap admin) di luar
# NODE_ENV=development. Set WEB_TARGET_CONFIRM=YES hanya setelah memverifikasi
# DB_NAME benar-benar database target (bukan testing lokal).
# WEB_TARGET_CONFIRM=
# ===== Web Admin — Pengaturan token bot (Tahap 3) =====
# Kunci enkripsi AES-256-GCM untuk menyimpan token bot via Web Admin
# (ditulis terenkripsi ke app_settings). WAJIB diisi agar fitur "Pengaturan
# Token" aktif; tanpa ini penyimpanan token via web dinonaktifkan (fail-closed).
# Generate: openssl rand -hex 32
WEB_SETTINGS_KEY=

